#ifndef PELAGIA_CORE_UTIL_VERSION_H
#define PELAGIA_CORE_UTIL_VERSION_H

// Généré par CMake à partir de project(pelagia VERSION ...) : ne pas éditer.

namespace util {

constexpr const char kVersion[] = "@PROJECT_VERSION@";      // e.g. "0.1.0"
constexpr const char kVersionTag[] = "v@PROJECT_VERSION@";  // e.g. "v0.1.0", same as the Git tag

}  // namespace util

#endif  // PELAGIA_CORE_UTIL_VERSION_H
